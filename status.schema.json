{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project status file",
  "description": "Input for generate-status-page.mjs. Phase numbers must run 0, 1, 2, ... in order, and current.phase must match one of them (the script enforces both; JSON Schema cannot).",
  "type": "object",
  "required": ["schemaVersion", "updated", "project", "current", "phases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updated": { "type": "string", "minLength": 1, "description": "Date or label shown in the footer." },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "current": {
      "type": "object",
      "required": ["headline", "summary", "nextAction", "phase"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "nextAction": { "type": "string", "minLength": 1 },
        "phase": { "type": "integer", "minimum": 0, "description": "Number of the phase in focus." }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "summary", "confirmation", "state"],
        "properties": {
          "number": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "confirmation": { "type": "string", "minLength": 1, "description": "The done-gate for this phase." },
          "state": { "$ref": "#/$defs/state" },
          "tag": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "summary", "state"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "summary": { "type": "string", "minLength": 1 },
                "state": { "$ref": "#/$defs/state" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "state": { "enum": ["planned", "in_progress", "blocked", "complete"] }
  }
}
